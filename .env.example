# ============================================
# Neuropod AI - environment configuration
# ============================================

# Core
NEUROPOD_BASE_URL=http://localhost:8000
NEUROPOD_FRONTEND_URL=http://localhost:3000
NEUROPOD_DEFAULT_TOPICS=language models,retrieval augmented generation,robotics
NEUROPOD_DEFAULT_EPISODES=3
NEUROPOD_DISCOVERY_WINDOW_DAYS=7

# Live arXiv discovery (set true once you have keys configured)
NEUROPOD_LIVE_DISCOVERY=false

ENABLE_SCHEDULER=false
NEUROPOD_SCHEDULER_TIMEZONE=America/Los_Angeles

# CORS - comma separated, must match the frontend origin in production
NEUROPOD_CORS_ORIGINS=http://localhost:3000

# ============================================
# Auth
# ============================================
# 'stub' = local dev (any email logs in, no password)
# 'cognito' = production (verifies Cognito JWT)
NEUROPOD_AUTH_MODE=stub
NEUROPOD_COGNITO_REGION=
NEUROPOD_COGNITO_POOL_ID=
NEUROPOD_COGNITO_CLIENT_ID=

# ============================================
# Database
# ============================================
# Production: postgres://user:pass@host:5432/dbname
# Local dev: leave empty to use a SQLite file at data/neuropod.sqlite3
NEUROPOD_DATABASE_URL=
NEUROPOD_SQLITE_PATH=data/neuropod.sqlite3

# ============================================
# Daily per-user rate limits
# ============================================
NEUROPOD_DAILY_PIPELINE_LIMIT=20
NEUROPOD_DAILY_ASK_LIMIT=200

# ============================================
# Audio storage
# ============================================
# Keep the main pipeline script-first. Set true only if you want every pipeline
# run to synthesize TTS immediately instead of generating audio per episode.
NEUROPOD_GENERATE_AUDIO_ON_PIPELINE=false
NEUROPOD_AUDIO_BACKEND=disk      # 'disk' (local) or 's3' (production)
NEUROPOD_S3_BUCKET=
NEUROPOD_S3_PREFIX=audio/
NEUROPOD_PRESIGN_TTL=86400
NEUROPOD_DISK_AUDIO_ROOT=data/audio_cache

# ============================================
# AI providers (operator-funded - keys live here, not per user)
# ============================================
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_TTS_VOICE=alloy
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Provider routing (auto = use real if key present, demo otherwise)
NEUROPOD_LLM_PROVIDER=auto       # auto | bedrock | anthropic | openai
NEUROPOD_TTS_PROVIDER=auto       # auto | elevenlabs | openai | demo
NEUROPOD_EMBEDDER=auto           # auto | demo

# AWS Bedrock (uses the task's IAM role; off by default)
NEUROPOD_BEDROCK_OPERATOR=false
NEUROPOD_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6-20251010-v1:0

# ============================================
# Frontend
# ============================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Spend caps.
#
# The per-user daily limits above are NOT a spend bound on their own: stub-mode
# login mints a persistent identity for any email with no verification, so the
# per-user quota resets for free with a new account. These three are the ones
# that actually cap blast radius on a public deployment.
#
# Exceeding a USD cap degrades to demo mode (zero-cost template scripts and
# deterministic metadata answers); it does not error. The global run cap
# rejects with 429.
#
# Set a cap at the provider as well — that is the only one a bug here can't
# bypass.
# ---------------------------------------------------------------------------
NEUROPOD_MONTHLY_BUDGET_USD=5.0
NEUROPOD_DAILY_BUDGET_USD=1.0
NEUROPOD_GLOBAL_DAILY_RUN_LIMIT=60
