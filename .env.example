# ============================================
# Neuropod AI — environment configuration
# ============================================

# Core
NEUROPOD_BASE_URL=http://localhost:8000
NEUROPOD_FRONTEND_URL=http://localhost:3000
NEUROPOD_DEFAULT_TOPICS=language models,retrieval augmented generation,robotics
NEUROPOD_DEFAULT_EPISODES=3
NEUROPOD_DISCOVERY_WINDOW_DAYS=7

# Live arXiv discovery (set true once you have keys configured)
NEUROPOD_LIVE_DISCOVERY=false

ENABLE_SCHEDULER=false
NEUROPOD_SCHEDULER_TIMEZONE=America/Los_Angeles

# CORS — comma separated, must match the frontend origin in production
NEUROPOD_CORS_ORIGINS=http://localhost:3000

# ============================================
# Auth
# ============================================
# 'stub' = local dev (any email logs in, no password)
# 'cognito' = production (verifies Cognito JWT)
NEUROPOD_AUTH_MODE=stub
# When AUTH_MODE=cognito, set:
NEUROPOD_COGNITO_REGION=
NEUROPOD_COGNITO_POOL_ID=
NEUROPOD_COGNITO_CLIENT_ID=

# ============================================
# Database
# ============================================
# Production: postgres://user:pass@host:5432/dbname
# Local dev: leave empty to use a SQLite file at data/neuropod.sqlite3
NEUROPOD_DATABASE_URL=
NEUROPOD_SQLITE_PATH=data/neuropod.sqlite3

# ============================================
# Encryption
# ============================================
# Required in production. Generate with:
#   python -c "from api.crypto import generate_master_key; print(generate_master_key())"
NEUROPOD_MASTER_KEY=

# ============================================
# BYOK enforcement
# ============================================
# When true, providers refuse to use the operator's env keys for user requests.
NEUROPOD_REQUIRE_USER_KEYS=true

# Daily per-user caps
NEUROPOD_DAILY_PIPELINE_LIMIT=20
NEUROPOD_DAILY_ASK_LIMIT=200

# ============================================
# Audio storage
# ============================================
# 'disk' (local) or 's3' (production)
NEUROPOD_AUDIO_BACKEND=disk
NEUROPOD_S3_BUCKET=
NEUROPOD_S3_PREFIX=audio/
NEUROPOD_PRESIGN_TTL=86400
NEUROPOD_DISK_AUDIO_ROOT=data/audio_cache

# ============================================
# Provider routing (auto = use real if key present, demo otherwise)
# ============================================
NEUROPOD_LLM_PROVIDER=auto       # auto | anthropic | openai
NEUROPOD_TTS_PROVIDER=auto       # auto | elevenlabs | openai | demo
NEUROPOD_EMBEDDER=auto           # auto | demo

# Fallback / operator-mode keys (only used when NEUROPOD_REQUIRE_USER_KEYS=false)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_TTS_VOICE=alloy
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ============================================
# Frontend
# ============================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
